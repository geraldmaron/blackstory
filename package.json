{
  "name": "blackstory",
  "private": true,
  "version": "0.0.0",
  "description": "BlackStory — place-connected Black history research platform (monorepo; code scope @repo)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "build": "pnpm run build:foundation && pnpm -r --filter './packages/**' --filter './apps/**' --filter '!@repo/schemas' --filter '!@repo/data-access' --filter '!@repo/ui' --filter '!@repo/domain' --filter '!@repo/security' --filter '!@repo/observability' run build",
    "build:foundation": "pnpm --filter @repo/schemas --filter @repo/ui run build && pnpm --filter @repo/domain run build && pnpm --filter @repo/data-access run build && pnpm --filter @repo/security run build && pnpm --filter @repo/observability run build",
    "test": "pnpm test:preflight && pnpm -r --filter './packages/**' --filter './apps/**' run --if-present test && uv run pytest",
    "test:preflight": "node --import tsx scripts/test-preflight.mjs",
    "test:js": "pnpm test:preflight && pnpm -r --filter './packages/**' --filter './apps/**' run --if-present test",
    "test:py": "pnpm test:preflight && uv run pytest",
    "test:unit": "pnpm test:preflight && pnpm --filter @repo/testing test:unit && pnpm -r --filter './packages/**' --filter './apps/**' --filter '!@repo/testing' run --if-present test && uv run pytest",
    "test:contract": "pnpm test:preflight && pnpm --filter @repo/testing test:contract",
    "test:security": "pnpm test:preflight && pnpm --filter @repo/testing test:security",
    "test:a11y": "pnpm test:preflight && pnpm --filter @repo/testing test:a11y",
    "test:integration": "pnpm test:preflight && pnpm --filter @repo/testing test:integration",
    "test:migration": "pnpm test:preflight && pnpm --filter @repo/testing test:migration",
    "test:e2e": "pnpm test:preflight && pnpm --filter @repo/testing test:e2e",
    "test:coverage": "pnpm test:preflight && pnpm --filter @repo/testing test:coverage",
    "typecheck": "pnpm -r --filter './packages/**' --filter './apps/**' run --if-present typecheck",
    "lint": "eslint apps packages scripts eslint.config.mjs --max-warnings 0 --ignore-pattern 'apps/mobile/**'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm --filter @repo/docs dev",
    "docs:build": "DOCS_BASE_PATH=/blackstory pnpm --filter @repo/docs build",
    "docs:publish": "bash scripts/publish-docs-pages.sh",
    "validate": "pnpm validate:boundaries && pnpm validate:web-entity-visibility && pnpm lint && pnpm validate:governance",
    "validate:boundaries": "node scripts/validate-boundaries.mjs",
    "validate:web-entity-visibility": "node scripts/check-web-entity-visibility-guards.mjs",
    "validate:governance": "node scripts/validate-github-governance.mjs",
    "dev:web": "./scripts/dev-web.sh",
    "mobile:seeds": "node --conditions=development --import tsx apps/mobile/scripts/generate-seeds.mjs",
    "mobile:seeds:check": "node --conditions=development --import tsx apps/mobile/scripts/generate-seeds.mjs --check",
    "mobile:ios:release": "./scripts/mobile-ios-release.sh",
    "mobile:ios:verify": "./scripts/mobile-ios-release.sh --verify-only",
    "mobile:ios:launch": "./scripts/mobile-ios-release.sh --launch-only",
    "dev:mobile": "./scripts/dev-mobile.sh",
    "dev:mobile:verify": "./scripts/dev-mobile.sh --verify-only",
    "dev:mobile:start": "./scripts/dev-mobile.sh --start",
    "ensure-api-public": "./scripts/ensure-api-public.sh",
    "ensure-metro": "./scripts/ensure-metro.sh",
    "probe-metro": "node scripts/probe-metro.mjs",
    "db:up": "docker compose -f infra/database/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/database/docker-compose.yml down",
    "db:status": "docker compose -f infra/database/docker-compose.yml ps",
    "db:init": "bash infra/database/scripts/apply-init.sh",
    "db:verify": "bash infra/database/scripts/verify-isolation.sh",
    "db:sql-connect:compile": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase dataconnect:compile -c infra/database/sql-connect/firebase.json",
    "db:sql-connect:sdk": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase dataconnect:sdk:generate -c infra/database/sql-connect/firebase.json",
    "test:db:integration": "pnpm --filter @repo/data-access test:integration"
  },
  "devDependencies": {
    "@geraldmaron/construct": "^2.0.1",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "firebase-tools": "^15.24.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=14.0.0",
      "@hono/node-server": ">=2.0.0",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "fast-uri": ">=4.1.2",
      "hono": ">=4.12.34",
      "ip-address": ">=10.3.1",
      "tar": ">=7.5.21",
      "@opentelemetry/core": ">=2.8.0",
      "undici": ">=8.9.0",
      "brace-expansion": ">=5.0.9"
    }
  }
}
