{
  "expo": {
    "name": "bs-spike",
    "slug": "bs-spike",
    "scheme": "bsspike",
    "web": { "bundler": "metro", "output": "server" },
    "plugins": [
      [
        "expo-router",
        {
          "unstable_useServerMiddleware": true,
          "unstable_useServerDataLoaders": true,
          "asyncRoutes": { "web": true, "default": false }
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
