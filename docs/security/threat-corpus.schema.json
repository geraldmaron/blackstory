{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo:schema:security-threat-corpus",
  "title": "BlackStory threat corpus",
  "type": "object",
  "required": ["version", "updatedAt", "assumptionsRef", "architectureRefs", "threats"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date" },
    "assumptionsRef": { "$ref": "#/$defs/repositoryPath" },
    "architectureRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "threats": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "priority",
          "abuseCaseIds",
          "implementationRefs",
          "controls",
          "residualRisk"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-(0[1-9]|1[0-9])$"
          },
          "name": { "type": "string", "minLength": 1 },
          "priority": { "const": "P0" },
          "assets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "actors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "abuseCaseIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^AC-[0-9]{2}$" }
          },
          "implementationRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/repositoryPath" }
          },
          "controls": {
            "type": "object",
            "required": ["preventive", "detective", "containment", "recovery"],
            "additionalProperties": false,
            "properties": {
              "preventive": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "detective": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "containment": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "recovery": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "residualRisk": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
