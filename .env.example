# Environment templates (names and placeholders only)
#
# Copy to `.env.local` (gitignored) for local Next.js.
#
# Production secrets: Vercel project env (public web). Admin is its own Vercel project.
# Firebase Hosting / App Hosting / Firestore are not on the public web request path.
# NEXT_PUBLIC_FIREBASE_* below are leftover App Check templates for local/api-public
# history. apps/web does not import a Firebase client. Never point them at the
# production project (black-book-efaaf) unless BLACK_BOOK_FIREBASE_ALLOW_PRODUCTION=1.

# Runtime
NODE_ENV=development
LOG_LEVEL=info
BLACK_BOOK_ENV=development

# Leftover Firebase App Check identifiers (not used by apps/web). FIREBASE_PROJECT_ID and
# the NEXT_PUBLIC_FIREBASE_* values are demo placeholders for packages that still compile
# against @repo/firebase. They are not Firestore config.
FIREBASE_PROJECT_ID=demo-repo

# Public web client identifiers for App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-repo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-repo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:332234323945:web:17be349ebc9c029b3bfd78
NEXT_PUBLIC_FIREBASE_ADMIN_APP_ID=1:332234323945:web:e1b31c78e32d95943bfd78

# App Check (BB-011 scaffold only — enforcement is BB-024)
# NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=replace-with-recaptcha-enterprise-site-key

# Server Admin SDK — leave unset for emulators. Never commit credential files.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json

# Embedding pipeline (BB-071 / ADR-014) — Gemini Developer API key for gemini-embedding-001.
# Production values belong in Secret Manager, never here. Tests/CI use the deterministic mock
# provider (@repo/firebase's createDeterministicMockEmbeddingProvider) and need no key.
# GEMINI_API_KEY=replace-with-secret-manager-reference

# OpenRouter lanes (black-history research profile). No Opus/Sonnet/Gemini/GPT-5 in these pins.
# OPENROUTER_API_KEY=op://…  (use run-with-dev-secrets locally; enrichment.env on Corsair)
# EDITORIAL_LLM_PROVIDER=hybrid
#
# 1) Free overnight batch (OPENROUTER_MODELS rotates on 429/5xx; OPENROUTER_MODEL pin wins):
# OPENROUTER_MODELS=openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
#
# 2) Paid research / connect-the-dots (default roster when OPENROUTER_MODELS unset):
# OPENROUTER_MODELS=deepseek/deepseek-r1-0528,deepseek/deepseek-v3.2,qwen/qwen3.5-122b-a10b
# OPENROUTER_MODEL=deepseek/deepseek-r1-0528
#
# 3) Quality prose / story rewrite (separate lane; never auto-publishes):
# STORY_REWRITE_LLM_PROVIDER=openrouter  # mock | openrouter | ollama | hybrid
# STORY_REWRITE_MODELS=moonshotai/kimi-k2.5,qwen/qwen3.5-122b-a10b,deepseek/deepseek-v3.2,mistralai/mistral-medium-3.1
# STORY_REWRITE_MODEL=  # optional single-model pin; otherwise the roster rotates on failure
# Artifacts: .cache/story-rewrites/{slug}.json — see docs/research/story-rewrite-review.md
#
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b
# TARGET_CANDIDATES=1000
# ENRICH_CONCURRENCY=4
# Without OPENROUTER_API_KEY the rewrite lane falls back to mock artifacts for review workflow.
#
# No local Ollama? Contributors don't need one: leave OLLAMA_BASE_URL unset and use
# EDITORIAL_LLM_PROVIDER=openrouter (or the mock provider) instead — see lanes 1-3 above.
# Operators with dedicated local-LLM hardware set RESEARCH_LOCAL_LLM_HOST (hostname/IP,
# no scheme/port) so scripts/run-overnight-hybrid-enrichment.sh can reach it when
# 127.0.0.1 isn't the LLM host; see .env.corsair.example for the one-operator profile.
# RESEARCH_LOCAL_LLM_HOST=

# Self-hosted SearXNG (preferred OSS web-search discovery; optional, contributors can skip it).
# Live: SEARXNG_BASE_URL=http://127.0.0.1:8888 DISCOVERY_STORAGE_TERMS_CONFIRMED=true
# Inject: DISCOVERY_SEARXNG_JSON=/path/to/searxng-response.json
# Optional reverse-proxy token: SEARXNG_AUTH_TOKEN=...
# SEARXNG_BASE_URL=http://127.0.0.1:8888
# Query roster (default): packages/config/src/scheduled-jobs/data/corsair-web-search-queries.json
# DISCOVERY_SEARXNG_QUERY_FILE=/path/to/corsair-web-search-queries.json
# DISCOVERY_QUERIES_PER_RUN=3
# DISCOVERY_SEARXNG_QUERY=…   # optional single-query override (skips roster rotation)
# Overnight: SEARXNG_QUERIES_PER_NIGHT=8 SKIP_SEARXNG=0
# DISCOVERY_STORAGE_TERMS_CONFIRMED=true
# Operators with a dedicated SearXNG host set RESEARCH_SEARXNG_HOST (hostname/IP, no
# scheme/port); see .env.corsair.example for the one-operator profile.
# RESEARCH_SEARXNG_HOST=

# Community discovery adapters (BB-073) — free DPLA v2 API key (api.dp.la/v2).
# Production values belong in Secret Manager, never here. Tests/CI use a deterministic fake key
# with a mocked SafeHttpClient (packages/domain/src/adapters/dpla) and need no real key.
# DPLA_API_KEY=replace-with-secret-manager-reference

# Optional Brave fallback (only if DISCOVERY_WEB_SEARCH_PROVIDER=brave).
# BRAVE_SEARCH_API_KEY=replace-with-secret-manager-reference

# Census data API (black-book-vxz) — free api.census.gov key, caller-supplied to the
# @repo/domain census-demographics adapters (never read inside the adapter; DPLA pattern).
# Local: op read "op://Private/USCensus/credential" >> .env.local as CENSUS_API_KEY=...
# Production: Secret Manager secret `census-api-key`, never here. Provenance sourceUrl is
# always the keyless form (buildProvenanceSourceUrl) — the key must never be persisted.
# CENSUS_API_KEY=replace-with-secret-manager-reference

# Production break-glass (do not set for routine local work)
# BLACK_BOOK_FIREBASE_ALLOW_PRODUCTION=1

# Local PostGIS (not a secret for disposable local compose)
DATABASE_URL=postgresql://blackbook:blackbook@localhost:5432/blackbook
BLACK_BOOK_DB_ROLE=role_public_read
# DATABASE_POOL_MAX=10
# DATABASE_POOL_ACQUIRE_TIMEOUT_MS=2000

# Public web + api-public structured-data backend (server reads; never NEXT_PUBLIC_* DB URLs):
# PUBLIC_DATA_SOURCE=seed|postgres
#   postgres — canonical SoR path (Supabase blackstory-app `bb_public.*`); required for production
#   seed — bundled snapshot for local UI without DATABASE_URL
#   firestore is not a valid value (removed; live-policy ignores it)
# PUBLIC_READ_API_DISABLED=0
# Documented as a Vercel kill switch; apps/web live-policy does not currently read this flag.
# APP_PUBLIC_RELEASE_ARTIFACT_BASE_URL=https://twykhihqkcldpreuovay.supabase.co/storage/v1/object/public/public-media
# Postgres mode uses that origin as the catalog read-through cache. Fetch timeout is 60s;
# an 8s timeout treats a 13.8 MB GET as a miss and falls back to full-catalog SQL.
#
# api-public (`apps/api-public`) uses the same Postgres vars as web — no separate mobile DB URL.
# Mobile clients MUST NOT embed DATABASE_URL; they read via HTTPS `/v1` only.
# Supabase Postgres cutover (blackstory-app) — direct pooler / service_role only:
# DATABASE_URL=op://Private/<item-id>/credential
# APP_DATABASE_URL=op://Private/<item-id>/credential
# DATABASE_SSL=1
# SUPABASE_ACCESS_TOKEN=op://Private/Supabase/credential
#
# Supabase Auth / Data API keys (server or admin surfaces only — NEVER mobile, NEVER commit live values).
# Prefer op:// refs via run-with-dev-secrets / ~/.env.1password.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=op://Developer/<item>/publishable_key   # aka anon / sb_publishable_*
# SUPABASE_SECRET_KEY=op://Developer/<item>/secret_key             # HUMAN must set full value; redacted paste is not enough
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_CAPTURE_BUCKET=raw-sources  # private Storage bucket for evidence capture snapshots (default: raw-sources)
# Legacy aliases still used by some admin templates:
# SUPABASE_ANON_KEY=op://Developer/<item>/publishable_key
# SUPABASE_SERVICE_ROLE_KEY=op://Developer/<item>/secret_key
#
# Public map reads do NOT use @supabase/server or these keys from the client —
# mobile Explore uses GET apps/api-public /v1/map (ADR-022 / ADR-025).

# Never set NEXT_PUBLIC_* database URLs — browsers must not receive DB credentials.
# NEXT_PUBLIC_DATABASE_URL=  # FORBIDDEN
