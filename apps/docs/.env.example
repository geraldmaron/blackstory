# apps/docs local environment template (placeholders only)
# Copy to apps/docs/.env.local.

# Base path the docs site is served under (GitHub Pages project site).
# CI sets this to /blackstory for docs:build; leave unset for local dev at /.
# DOCS_BASE_PATH=/blackstory

# Absolute origin used to build canonical/OG URLs in layout.tsx metadata.
# Defaults to https://geraldmaron.github.io<DOCS_BASE_PATH> when unset.
# NEXT_PUBLIC_SITE_URL=https://geraldmaron.github.io/blackstory
