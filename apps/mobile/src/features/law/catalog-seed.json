      "id": "legal-brown-1954",
      "slug": "brown-v-board-of-education",
      "title": "Brown v. Board of Education",
      "kind": "landmark-case",
      "lawStatus": "in_force",
      "jurisdictionId": "us",
      "topics": [
        "education",
        "constitutional"
      ],
      "citation": "347 U.S. 483 (1954)",
      "sourceUrl": "https://www.courtlistener.com/opinion/108713/brown-v-board-of-education/",
      "officialUrl": "https://www.courtlistener.com/opinion/108713/brown-v-board-of-education/",
      "archivedCaptureUrl": "https://web.archive.org/web/20260717000000/https://www.courtlistener.com/opinion/108713/brown-v-board-of-education/",
      "retrievedAt": "2026-07-17T00:00:00.000Z",
      "licenseTag": "public-domain",
      "factId": "BB-F-000014",
      "canonicalEntityId": "ent_case_brown_v_board_of_education_1954",
      "explainer": {
        "whatItSays": "Brown v. Board of Education, 347 U.S. 483 (1954), held that racial segregation in public schools violates the Equal Protection Clause of the Fourteenth Amendment.",
        "whatItMeans": [
          "The Court overturned Plessy v. Ferguson's \"separate but equal\" rule for public schools.",
          "Chief Justice Warren wrote for a unanimous Court that separate schools are \"inherently unequal.\"",
          "The decision did not set a deadline for desegregation — Brown II (1955) called for it \"with all deliberate speed.\""
        ],
        "whyItMatters": [
          "School segregation was the legal backbone of Jim Crow. Brown opened the door to the modern civil-rights movement.",
          "Many districts resisted for years; federal troops were sent to Little Rock Central High School in 1957."
        ],
        "rightsToday": [
          {
            "label": "File an education civil-rights complaint (DOJ)",
            "agencyUrl": "https://civilrights.justice.gov/"
          },
          {
            "label": "File a school discrimination complaint (OCR)",
            "agencyUrl": "https://www2.ed.gov/about/offices/list/ocr/complaintintro.html"
          }
        ],
        "primarySources": [
          {
            "label": "CourtListener — Brown v. Board",
            "url": "https://www.courtlistener.com/opinion/108713/brown-v-board-of-education/",
            "licenseTag": "public-domain"
          },
