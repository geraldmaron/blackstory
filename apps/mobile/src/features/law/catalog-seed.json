      "id": "legal-1983",
      "slug": "42-usc-1983",
      "title": "42 U.S.C. § 1983 — Civil action for deprivation of rights",
      "kind": "federal-statute",
      "lawStatus": "in_force",
      "jurisdictionId": "us",
      "topics": [
        "policing",
        "employment"
      ],
      "citation": "42 U.S.C. § 1983",
      "sourceUrl": "https://www.ecfr.gov/current/title-42/chapter-21/subchapter-I/part-1983",
      "officialUrl": "https://www.ecfr.gov/current/title-42/chapter-21/subchapter-I/part-1983",
      "archivedCaptureUrl": "https://web.archive.org/web/20260717000000/https://www.ecfr.gov/current/title-42/chapter-21/subchapter-I/part-1983",
      "retrievedAt": "2026-07-17T00:00:00.000Z",
      "licenseTag": "public-domain",
      "factId": "BB-F-000013",
      "explainer": {
        "whatItSays": "42 U.S.C. § 1983 lets people sue state and local officials who violate their federal constitutional or statutory rights while acting under \"color of law.\"",
        "whatItMeans": [
          "You can seek money damages and court orders against officials who violate your rights.",
          "The official must be acting in their government role — not as a private citizen.",
          "Qualified immunity may limit suits against individual officers in some circumstances."
        ],
        "whyItMatters": [
          "Section 1983 is the main federal tool for holding police and government officials accountable for civil-rights violations.",
          "It was originally part of the Ku Klux Klan Act of 1871 to protect freedmen from state violence."
        ],
        "rightsToday": [
          {
            "label": "Report police misconduct (DOJ)",
            "agencyUrl": "https://civilrights.justice.gov/"
          },
          {
            "label": "Find a legal aid office (LSC)",
            "agencyUrl": "https://www.lsc.gov/about-lsc/what-legal-aid/get-legal-help"
          }
        ],
        "primarySources": [
          {
            "label": "eCFR — 42 U.S.C. § 1983",
            "url": "https://www.ecfr.gov/current/title-42/chapter-21/subchapter-I/part-1983",
            "licenseTag": "public-domain"
          }
        ],
        "reviewedAt": "2026-07-10",
        "termOfArtLinks": [
