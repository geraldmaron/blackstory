      "id": "legal-shelby-2013",
      "slug": "shelby-county-v-holder",
      "title": "Shelby County v. Holder",
      "kind": "landmark-case",
      "lawStatus": "in_force",
      "jurisdictionId": "us",
      "topics": [
        "voting",
        "constitutional"
      ],
      "citation": "570 U.S. 529 (2013)",
      "sourceUrl": "https://www.courtlistener.com/opinion/813086/shelby-county-v-holder/",
      "officialUrl": "https://www.courtlistener.com/opinion/813086/shelby-county-v-holder/",
      "archivedCaptureUrl": "https://web.archive.org/web/20260717000000/https://www.courtlistener.com/opinion/813086/shelby-county-v-holder/",
      "retrievedAt": "2026-07-17T00:00:00.000Z",
      "licenseTag": "public-domain",
      "factId": "BB-F-000015",
      "canonicalEntityId": "ent_case_shelby_county_v_holder_2013",
      "explainer": {
        "whatItSays": "Shelby County v. Holder, 570 U.S. 529 (2013), struck down the Voting Rights Act's coverage formula that determined which states needed federal preclearance for election changes.",
        "whatItMeans": [
          "The Court said the 1965 coverage formula was outdated and violated state sovereignty.",
          "Section 2 still bans discriminatory voting practices nationwide, but preclearance no longer applies automatically.",
          "Congress has not passed a new coverage formula since the decision."
        ],
        "whyItMatters": [
          "States that had been under preclearance quickly passed new voting laws after Shelby County.",
          "Civil-rights groups argue the decision removed a key guardrail against voter suppression."
        ],
        "rightsToday": [
          {
            "label": "Report a voting rights violation (DOJ)",
            "agencyUrl": "https://civilrights.justice.gov/"
          }
        ],
        "primarySources": [
          {
            "label": "CourtListener — Shelby County",
            "url": "https://www.courtlistener.com/opinion/813086/shelby-county-v-holder/",
            "licenseTag": "public-domain"
          }
        ],
        "reviewedAt": "2026-07-10"
      }
    },
