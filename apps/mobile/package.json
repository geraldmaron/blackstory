    "@expo/plist": {
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo/ui": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-community/netinfo": "~12.0.1",
    "@repo/domain": "file:../../packages/domain",
    "@repo/domain-core": "file:../../packages/domain-core",
    "@repo/public-contracts": "file:../../packages/public-contracts",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
