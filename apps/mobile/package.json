  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prestart": "bash ../../scripts/ensure-api-public.sh",
    "start": "expo start",
    "dev": "../../scripts/dev-mobile.sh",
    "ensure-api": "../../scripts/ensure-api-public.sh",
    "ensure-metro": "../../scripts/ensure-metro.sh",
    "probe-metro": "node ../../scripts/probe-metro.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "test": "jest",
    "seeds:generate": "node --conditions=development --import tsx scripts/generate-seeds.mjs",
    "seeds:check": "node --conditions=development --import tsx scripts/generate-seeds.mjs --check",
    "tokens:generate": "node --import tsx scripts/generate-brand-tokens.ts",
    "tokens:check": "node --import tsx scripts/generate-brand-tokens.ts --check",
    "build": "expo export",
    "prebuild": "expo prebuild",
    "bundle-size": "node --import tsx scripts/report-bundle-size.ts",
    "eas-build:development": "npx eas-cli build --profile development",
    "eas-build:preview": "npx eas-cli build --profile preview",
    "eas-build:production": "npx eas-cli build --profile production",
    "eas-build-post-install": "npm install --prefix ../../packages/public-contracts --omit=dev --no-package-lock --ignore-scripts && npx tsc -p ../../packages/public-contracts/tsconfig.json && npm install --prefix ../../packages/domain --omit=dev --no-package-lock --ignore-scripts && npx tsc -p ../../packages/domain/tsconfig.json"
  }
}
