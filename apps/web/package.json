{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p ${PORT:-3048}",
    "prebuild": "pnpm -w --filter @repo/web^... --filter '!blackstory' --workspace-concurrency=1 run build",
    "build": "next build --webpack",
    "start": "next start --port 3048",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions development --import tsx --import ./test/css-stub.mjs --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "lint": "echo 'lint: use root pnpm lint'",
    "locator:build": "node --import tsx scripts/build-us-locator-svg.mts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@repo/config": "workspace:*",
    "@repo/data-access": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/operator-cli": "workspace:*",
    "@repo/operator-mcp": "workspace:*",
    "@repo/ops-data": "workspace:*",
    "@repo/public-contracts": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@vercel/analytics": "^2.0.1",
    "baseui": "16.1.1",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styletron-engine-monolithic": "^1.0.0",
    "styletron-react": "^6.1.1",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styletron-react": "^5.0.8",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
