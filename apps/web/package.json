{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p ${PORT:-3048}",
    "prebuild": "pnpm -w --filter @repo/web^... --filter '!blackstory' --workspace-concurrency=1 run build",
    "build": "next build --webpack",
    "start": "next start --port 3048",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions development --import tsx --import ./test/css-stub.mjs --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "lint": "echo 'lint: use root pnpm lint'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@repo/config": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/ui": "workspace:*",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.11",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
