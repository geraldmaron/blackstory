# apps/web local environment template (placeholders only)
# Copy to apps/web/.env.local.

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Same-origin request integrity for anonymous public mutation/read APIs.
# monitor — log failures but allow (default in non-production)
# enforce — fail closed on missing/mismatched CSRF token (default in production)
# REQUEST_INTEGRITY_MODE=monitor

# Public structured-data backend (server-side reads only):
# PUBLIC_DATA_SOURCE=seed|postgres
# PUBLIC_READ_API_DISABLED=1
# APP_PUBLIC_RELEASE_ARTIFACT_BASE_URL=https://twykhihqkcldpreuovay.supabase.co/storage/v1/object/public/public-media
# Postgres mode uses that origin as the ADR-004 read-through cache (entities.json /
# search-index.json). Without it, every cold start pulls the full catalog from Postgres.
#
# Local dig (entities on map/explore/search):
#   Prefer: pnpm dev:web   (loads DATABASE_URL if present; fails fast on postgres misconfig)
#   Or set both of:
#     PUBLIC_DATA_SOURCE=postgres
#     DATABASE_URL=…          # server-only; never NEXT_PUBLIC_*
#     OPENROUTER_API_KEY=…    # server-only; operator-cli enrichment-run (see docs/research/agent-local-env.md)
#     DATABASE_SSL=1
#   Without DATABASE_URL, unset PUBLIC_DATA_SOURCE falls back to the 4-entity Dunbar seed
#   (national dig looks empty). PUBLIC_DATA_SOURCE=postgres without DATABASE_URL returns
#   an EMPTY catalog (seed is refused by design).
#
# Postgres cutover (server-only; use service_role / direct pooler URL via 1Password):
# DATABASE_URL=op://Private/<item-id>/credential
# APP_DATABASE_URL=op://Private/<item-id>/credential
# DATABASE_SSL=1
# Note: Supabase URLs often include sslmode=require. The web/admin/ops pools normalize
# that to uselibpqcompat + rejectUnauthorized:false so node-pg does not fail with
# SELF_SIGNED_CERT_IN_CHAIN and silently fall back to the 4-entity seed snapshot.

# ── Admin console (/admin/**) ───────────────────────────────────────────────────────────────
# `/admin` is a staff-gated route group inside this app, not a separate deployable — see
# src/admin/. It needs its own write-capable Postgres credential (ADMIN_DATABASE_URL, distinct
# from the public read-only DATABASE_URL above) and Supabase Auth config, which this app did not
# previously have at all.
ADMIN_AUTH_MODE=supabase
NEXT_PUBLIC_ADMIN_AUTH_MODE=supabase
ADMIN_DATA_SOURCE=postgres

# Write-capable canonical Postgres credential (role_admin_app; bb_canonical/bb_ops/bb_research
# etc.). Never reused for the public DATABASE_URL above, and never NEXT_PUBLIC_*.
# ADMIN_DATABASE_URL=op://Private/<item-id>/credential
# ADMIN_APP_DATABASE_URL=

# Supabase Auth. Browser code receives only the publishable/anon key, never service_role/secret.
# SUPABASE_URL=https://twykhihqkcldpreuovay.supabase.co
# SUPABASE_ANON_KEY=<publishable key — prefer op://Developer/.../publishable_key>
# SUPABASE_PUBLISHABLE_KEY=<same as ANON_KEY; new naming>
# SUPABASE_SECRET_KEY=op://Developer/<item>/secret_key   # HUMAN must set full value; never commit
# SUPABASE_JWKS_URL=https://twykhihqkcldpreuovay.supabase.co/auth/v1/.well-known/jwks.json
# NEXT_PUBLIC_SUPABASE_URL=https://twykhihqkcldpreuovay.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<same publishable key>
#
# Provision operators in Supabase Auth before sign-in and set authorization only in
# app_metadata.bb_role: admin|research|publication|security. Never authorize from user_metadata.

# Optional local-only sign-in reminder for /admin/login.
# ADMIN_LOGIN_EMAIL=<supabase-auth-email>
# ADMIN_LOGIN_PASSWORD=<set locally>

# Explicit release activation break-glass for /admin/releases. Leave unset for normal admin work.
# APP_RELEASE_ALLOW_PRODUCTION=1

# Anonymous-submission privacy pepper (server-only). Keys the sha256 network token used for
# campaign detection so a raw client IP is never stored. REQUIRED in production — the app throws
# on boot without it. Non-production generates a random per-process value; there is deliberately
# no fixed dev fallback, so tokens are not comparable across restarts.
# SUBMISSION_PRIVACY_PEPPER=op://Private/<item-id>/credential

# Published contact addresses. Both default to me@geralddagher.com, which is the owner's decision
# (2026-08-04) rather than a placeholder — see apps/web/src/lib/config/contact.ts. Set these only
# to move the published contact somewhere else; no code change is needed either way.
# SUPPORT_CONTACT=
# SECURITY_TXT_CONTACT=

# ── Maintenance mode ─────────────────────────────────────────────────────────────────────────
# Parks the whole public surface behind an edge-served 503 without rendering a route or opening
# a connection to bb_public. See docs/runbooks/maintenance-mode.md before using any of this.
#
# These are read inside the edge bundle, and Next inlines them at build time: changing them in
# the Vercel dashboard does nothing until the project is REDEPLOYED. Set them on Production only,
# so Preview deployments stay a working window onto the same data.
#
# Fails open. Only 1 / true / on / enabled raises the wall; anything else leaves the site up.
# MAINTENANCE_MODE=1
#
# Shared team secret that lets a person through the wall. Unset means nobody can bypass.
# Redeem it once per browser at https://<site>/?maintenance_bypass=<token>; the token is then
# swapped for an HttpOnly cookie and dropped from the URL. Rotate it by changing this value.
# MAINTENANCE_BYPASS_TOKEN=op://Private/<item-id>/credential
#
# Advertised in Retry-After and used to word the "check again" line. Default 86400 (one day),
# capped at one week.
# MAINTENANCE_RETRY_AFTER_SECONDS=86400
#
# Optional replacement for the body copy. HTML-escaped before it reaches the page.
# MAINTENANCE_MESSAGE=
