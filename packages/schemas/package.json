{
  "name": "@repo/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./relationship-vocabulary": {
      "development": "./src/relationship-vocabulary.ts",
      "types": "./dist/relationship-vocabulary.d.ts",
      "import": "./dist/relationship-vocabulary.js"
    },
    "./package.json": "./package.json",
    "./story-inline": {
      "development": "./src/story-inline.ts",
      "types": "./dist/story-inline.d.ts",
      "import": "./dist/story-inline.js"
    },
    "./public-stories": {
      "development": "./src/public-stories.ts",
      "types": "./dist/public-stories.d.ts",
      "import": "./dist/public-stories.js"
    }
  },
  "files": [
    "dist",
    "constitution"
  ],
  "scripts": {
    "prebuild": "node ./scripts/sync-policy-json.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions development --import tsx --test src/constitution.test.ts src/banned-books.test.ts src/public-projections.test.ts src/public-stories.test.ts src/story-inline.test.ts src/editorial.test.ts src/relationship-vocabulary.test.ts",
    "lint": "echo 'lint: use root pnpm lint'"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
