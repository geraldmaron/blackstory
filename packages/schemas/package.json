{
  "name": "@repo/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./relationship-vocabulary": {
      "development": "./src/relationship-vocabulary.ts",
      "types": "./dist/relationship-vocabulary.d.ts",
      "import": "./dist/relationship-vocabulary.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "constitution"
  ],
  "scripts": {
    "prebuild": "node ./scripts/sync-policy-json.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions development --import tsx --test src/constitution.test.ts src/banned-books.test.ts src/public-projections.test.ts src/public-articles.test.ts src/relationship-vocabulary.test.ts",
    "lint": "echo 'lint: use root pnpm lint'"
  },
  "dependencies": {
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^26.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
