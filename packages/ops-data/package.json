{
  "name": "@repo/ops-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./management": {
      "development": "./src/management/work-store.ts",
      "types": "./dist/management/work-store.d.ts",
      "import": "./dist/management/work-store.js"
    },
    "./management/contracts": {
      "development": "./src/management/contracts.ts",
      "types": "./dist/management/contracts.d.ts",
      "import": "./dist/management/contracts.js"
    },
    "./management/dispatch": {
      "development": "./src/management/dispatch.ts",
      "types": "./dist/management/dispatch.d.ts",
      "import": "./dist/management/dispatch.js"
    },
    "./management/pdf-parser": {
      "development": "./src/management/pdf-parser.ts",
      "types": "./dist/management/pdf-parser.d.ts",
      "import": "./dist/management/pdf-parser.js"
    },
    "./management/catalog": {
      "development": "./src/management/catalog.ts",
      "types": "./dist/management/catalog.d.ts",
      "import": "./dist/management/catalog.js"
    },
    "./management/client": {
      "development": "./src/management/client.ts",
      "types": "./dist/management/client.d.ts",
      "import": "./dist/management/client.js"
    },
    "./management/delegations": {
      "development": "./src/management/delegations.ts",
      "types": "./dist/management/delegations.d.ts",
      "import": "./dist/management/delegations.js"
    },
    "./source-library": {
      "development": "./src/source-library.ts",
      "types": "./dist/source-library.d.ts",
      "import": "./dist/source-library.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "node --conditions development --import tsx --test 'src/**/*.test.ts' 'scripts/**/*.test.ts' 'fixtures/**/*.test.ts'",
    "lint": "echo 'lint: use root pnpm lint'"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@repo/data-access": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/domain-core": "workspace:*",
    "@repo/research-kernel": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/security": "workspace:*",
    "pg": "^8.16.3",
    "unpdf": "1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
