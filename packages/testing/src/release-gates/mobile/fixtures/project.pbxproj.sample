// !$*UTF8*$!
// Trimmed sample of an `expo prebuild` project.pbxproj, kept small enough to read.
// It deliberately contains three Release configurations: the app target, the PROJECT,
// and a Pods target, so the parser has to pick the right one rather than the first.
{
	objects = {

/* Begin PBXNativeTarget section */
		13B07F861A680F5B00A75B9A /* BlackStory */ = {
			isa = PBXNativeTarget;
			buildConfigurationList = 13B07F93 /* Build configuration list */;
			buildPhases = (
				AAAA0001 /* Sources */,
				AAAA0002 /* Resources */,
				AAAA0003 /* Bundle React Native code and images */,
				AAAA0004 /* [Expo Dev Launcher] Strip Local Network Keys for Release */,
			);
			name = BlackStory;
			productName = BlackStory;
			productType = "com.apple.product-type.application";
		};
/* End PBXNativeTarget section */

/* Begin XCBuildConfiguration section */
		13B07F941A680F5B00A75B9A /* Debug */ = {
			isa = XCBuildConfiguration;
			buildSettings = {
				INFOPLIST_FILE = BlackStory/Info.plist;
				IPHONEOS_DEPLOYMENT_TARGET = 16.4;
				PRODUCT_BUNDLE_IDENTIFIER = app.blackstory.mobile;
				TARGETED_DEVICE_FAMILY = "1,2";
			};
			name = Debug;
		};
		83CBBA211A601CBA00E9B192 /* Release */ = {
			isa = XCBuildConfiguration;
			buildSettings = {
				ALWAYS_SEARCH_USER_PATHS = NO;
				IPHONEOS_DEPLOYMENT_TARGET = 15.1;
				SDKROOT = iphoneos;
			};
			name = Release;
		};
		13B07F951A680F5B00A75B9A /* Release */ = {
			isa = XCBuildConfiguration;
			baseConfigurationReference = A886AF7A /* Pods-BlackStory.release.xcconfig */;
			buildSettings = {
				CODE_SIGN_ENTITLEMENTS = BlackStory/BlackStory.entitlements;
				CURRENT_PROJECT_VERSION = 1;
				INFOPLIST_FILE = BlackStory/Info.plist;
				IPHONEOS_DEPLOYMENT_TARGET = 16.4;
				MARKETING_VERSION = 1.0;
				OTHER_LDFLAGS = (
					"$(inherited)",
					"-ObjC",
				);
				PRODUCT_BUNDLE_IDENTIFIER = app.blackstory.mobile;
				PRODUCT_NAME = BlackStory;
				TARGETED_DEVICE_FAMILY = "1,2";
			};
			name = Release;
		};
		CCCCDDDDEEEEFFFF00001111 /* Release */ = {
			isa = XCBuildConfiguration;
			buildSettings = {
				IPHONEOS_DEPLOYMENT_TARGET = 16.4;
				PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.Pods-BlackStory;
				PRODUCT_NAME = Pods_BlackStory;
			};
			name = Release;
		};
/* End XCBuildConfiguration section */
	};
}
