# OPERATOR-SPECIFIC PROFILE — NOT FOR CONTRIBUTORS.
#
# This file documents the "Corsair" profile: Gerald's dedicated Tailscale-networked
# workstation (gerald-corsair-ai-workstation-300, 100.119.72.84) that runs a local
# Ollama model and a local SearXNG instance for overnight research enrichment.
#
# Contributors do NOT need this file and should NOT copy real values from it into
# .env.example or .env.local. The default contributor path uses either the mock
# LLM/search providers or the OpenRouter free model roster — no local Ollama or
# SearXNG required. See .env.example and docs/runbooks/overnight-hybrid-enrichment.md.
#
# Usage (operator only): copy to a private, gitignored file and load it explicitly,
# e.g.
#   cp .env.corsair.example ~/.config/blackstory/corsair.env
#   set -a && source ~/.config/blackstory/corsair.env && set +a
# Never commit the populated copy — this checked-in file only ever holds the
# real, labeled operator values as documentation, not live secrets.

# Hostname/IP of the Corsair workstation on the Tailscale network. Scripts read
# these to build OLLAMA_BASE_URL / SEARXNG_BASE_URL only when localhost isn't
# the LLM/search host (see scripts/run-overnight-hybrid-enrichment.sh and
# scripts/run-scheduled-searxng-discovery.sh).
RESEARCH_LOCAL_LLM_HOST=100.119.72.84
RESEARCH_SEARXNG_HOST=100.119.72.84

# Direct overrides (equivalent to the two vars above, already scheme+port qualified).
OLLAMA_BASE_URL=http://100.119.72.84:11434/v1
OLLAMA_MODEL=qwen3:8b
SEARXNG_BASE_URL=http://100.119.72.84:8888

# Corsair also runs these locally, not remotely — kept here for completeness:
# EDITORIAL_LLM_PROVIDER=hybrid
# ENRICHMENT_OPERATOR_ID=overnight-hybrid-corsair
